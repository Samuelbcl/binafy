# ─────────────────────────────────────────────────────────────
# Nestor — variables d'environnement
#
# Copier ce fichier en `.env.local` et remplir ce dont tu as besoin.
# `.env.local` n'est JAMAIS commité (voir .gitignore).
#
# Tout est optionnel : sans Supabase, l'application démarre en mode démo sur
# des données fictives. Chaque bloc active une fonctionnalité supplémentaire.
# ─────────────────────────────────────────────────────────────


# ── Application ──────────────────────────────────────────────
# URL publique du site. Sert aux liens des emails, aux images OG et au sitemap.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Force le mode démo même si Supabase est configuré. Pratique pour les captures.
# NEXT_PUBLIC_MODE_DEMO="true"


# ── Supabase — Postgres, Auth, RLS, Storage ──────────────────
# Projet à créer en région `eu-central-1` (RGPD : hébergement UE obligatoire).
# Tableau de bord → Project Settings → API.
#
# Sans ces trois valeurs, l'app reste en mode démo et aucune donnée n'est stockée.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ⚠️ Clé de service : contourne la RLS. Serveur uniquement, jamais dans un
# Client Component, jamais préfixée NEXT_PUBLIC_. Sert aux jobs planifiés
# (snapshots quotidiens, cotations) et au seed des paramètres fiscaux.
SUPABASE_SERVICE_ROLE_KEY=""

# Personal Access Token du CLI Supabase.
# A generer sur https://supabase.com/dashboard/account/tokens
# Sert a lier le projet, appliquer les migrations et generer les types TypeScript.
# Jamais utilise par l'application elle-meme : outil de developpement uniquement.
SUPABASE_ACCESS_TOKEN=""

# Mot de passe de la base, demande par `supabase db push`.
# Project Settings -> Database -> Database password.
SUPABASE_DB_PASSWORD=""


# ── Chiffrement des secrets bancaires ────────────────────────
# Clé de chiffrement des tokens d'agrégation, qui ne sortent jamais du serveur.
# Générer avec : openssl rand -base64 32
ENCRYPTION_KEY=""


# ── Agrégation bancaire PSD2 — GoCardless Bank Account Data ──
# Ex-Nordigen. Retenu pour la V1 : bonne couverture des grandes banques belges
# et palier gratuit généreux. Accès en LECTURE SEULE, jamais d'initiation de
# paiement. Console : https://bankaccountdata.gocardless.com
GOCARDLESS_SECRET_ID=""
GOCARDLESS_SECRET_KEY=""

# Plan B / offre Pro : Ponto (Isabel Group, belge). L'interface `BankProvider`
# de src/lib/banking permet de basculer sans toucher au reste du code.
# PONTO_CLIENT_ID=""
# PONTO_CLIENT_SECRET=""


# ── Cotations ────────────────────────────────────────────────
# Actions, ETF et fonds — une seule des deux suffit.
# ⚠️ Vérifier la couverture des ISIN cotés à Euronext Bruxelles, Amsterdam et
# Xetra AVANT de choisir : beaucoup d'API grand public sont centrées US.
EODHD_API_KEY=""
# TWELVE_DATA_API_KEY=""

# Crypto — le plan gratuit CoinGecko ne demande pas de clé.
# COINGECKO_API_KEY=""


# ── Email transactionnel — Resend ────────────────────────────
# Rapports mensuels et alertes (consentement PSD2 expirant, seuils fiscaux).
RESEND_API_KEY=""
RESEND_FROM="Nestor <bonjour@nestor.be>"


# ── Jobs planifiés — Vercel Cron ─────────────────────────────
# Secret partagé qui authentifie les appels aux routes de cron.
# Générer avec : openssl rand -hex 32
CRON_SECRET=""
