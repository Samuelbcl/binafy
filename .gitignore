# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — jamais commites, sauf le template qui documente les variables attendues
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# fichier SQL derive, regenere par scripts/generer-sql-complet.mjs
supabase/schema-complet.generated.sql

# pages sources deposees manuellement, non versionnees
sources-fiscales/
!sources-fiscales/LISEZ-MOI.md

# canevas de design genere par la skill design (2,5 Mo), rejouable depuis les .dc.html
design/*.html
!design/*.dc.html

# captures de QA mobile, regenerables
captures/
